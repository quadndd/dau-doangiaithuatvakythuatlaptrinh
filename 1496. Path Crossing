class Solution(object):
    def isPathCrossing(self, path):
        """
        :type path: str
        :rtype: bool
        """
        visited = {(0,0)}
        x , y = 0 , 0
        for direction in path:
            if direction=='N':
                y += 1
            elif direction=='E':
                x += 1
            elif direction=='S':
                y -= 1
            else:
                x -= 1
            if (x , y) in visited:
                return True
            else:
                visited.add((x , y))
        return False