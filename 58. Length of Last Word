class Solution(object):
    def lengthOfLastWord(self, s):
        """
        :type s: str
        :rtype: int
        """
        n = len(s)  
        index = n - 1
        count = 0
        while(index >= 0 and s[index] == ' '):
            index -= 1
        while(index >= 0 and s[index] != ' '):
            count += 1
            index -= 1 
        return count