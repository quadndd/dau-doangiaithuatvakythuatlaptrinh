class Solution(object):
    def maxPower(self, s):
        """
        :type s: str
        :rtype: int
        """
        ans = 1
        for i in range(len(s)):
            j = i + 1
            while j < len(s) and s[j] == s[j-1]:
                j += 1
            ans = max(ans, j-i)
        return ans