class Solution(object):
    def merge(self, nums1, m, nums2, n):
        """
        :type nums1: List[int]
        :type m: int
        :type nums2: List[int]
        :type n: int
        :rtype: None Do not return anything, modify nums1 in-place instead.
        """
        n2 = n
        for i in range(n):
            nums1[m + i] = nums2[n2 - 1]
            while n2 < 0:
                return
            n2 -= 1
        nums1.sort()