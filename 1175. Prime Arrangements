class Solution(object):
    def numPrimeArrangements(self, n):
        """
        :type n: int
        :rtype: int
        """
        if n <= 2:
            return 1
        
        is_prime = [1] * (n + 1)
        is_prime[:2] = [0, 0]

        for i in range(2, int(n ** 0.5) + 1):
            if is_prime[i]:
                for j in range(i * i, n + 1, i):
                    is_prime[j] = 0
        
        n_prime_numbers = sum(is_prime)

        return math.factorial(n - n_prime_numbers) * math.factorial(n_prime_numbers) % (10 ** 9 + 7)