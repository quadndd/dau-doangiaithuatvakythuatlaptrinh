class Solution(object):
    def calPoints(self, operations):
        """
        :type operations: List[str]
        :rtype: int
        """
        n = len(operations)
        res = [0] * n
        pointer = 0

        for op in operations:
            if op == "C":
                pointer -= 1
            elif op == "D":
                res[pointer] = 2 * res[pointer - 1]
                pointer += 1
            elif op == "+":
                res[pointer] = res[pointer - 1] + res[pointer - 2]
                pointer += 1
            else:
                res[pointer] = int(op)
                pointer += 1

        return sum(res[:pointer])