class Solution(object):
    def matrixReshape(self, mat, r, c):
        """
        :type mat: List[List[int]]
        :type r: int
        :type c: int
        :rtype: List[List[int]]
        """
        s = [[0] * c for _ in range(r)]
        x, y = 0, 0

        if len(mat) * len(mat[0]) == r * c:
            for i in range(len(mat)):
                for j in range(len(mat[0])):
                    if y == c:
                        x += 1
                        y = 0
                    s[x][y] = mat[i][j]
                    y += 1
            return s
        return mat