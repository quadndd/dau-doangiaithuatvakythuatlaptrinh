class Solution(object):
    def canPlaceFlowers(self, flowerbed, n):
        """
        :type flowerbed: List[int]
        :type n: int
        :rtype: bool
        """
        k=len(flowerbed)
        flowerbed.insert(0,0)
        flowerbed.append(0)
        for i in range(1,k+1):
            if flowerbed[i]==0:
                if flowerbed[i-1]==0 and flowerbed[i+1]==0:
                    flowerbed[i]=1
                    n-=1
        if n<=0:
            return True
        return False